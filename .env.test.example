# Isolated testing database
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=taqamind_test

# Test application credentials
DB_APP_USER=taqamind_test_app
DB_APP_PASSWORD=CHANGE_ME

# Test migration credentials
DB_MIGRATOR_USER=taqamind_test_migrator
DB_MIGRATOR_PASSWORD=CHANGE_ME

# Database configuration
DB_SCHEMA=taqamind

# Connection pooling
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=10